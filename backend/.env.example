# Copy this file to backend/.env and adjust as needed.

# ---- MongoDB ---------------------------------------------------------------
# Local MongoDB Community Server:
MONGO_URI=mongodb://localhost:27017
# MongoDB Atlas example (replace user, password and cluster):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=reviewiq
MONGO_TIMEOUT_MS=3000

# If MongoDB cannot be reached, fall back to a TEMPORARY in-memory store (data is not persisted).
# Set to false to require MongoDB (API returns 503 with setup instructions instead).
DEMO_MODE=true
# Always use the in-memory store, even if MongoDB is running (used by the test-suite).
FORCE_MEMORY_STORE=false
# Import data/sample/customer_reviews_preprocessed.csv on startup when the warehouse is empty.
AUTO_IMPORT_SAMPLE=true

# ---- Rating-derived sentiment rule ----------------------------------------
# rating <= RATING_NEGATIVE_MAX -> negative ; rating >= RATING_POSITIVE_MIN -> positive ; otherwise neutral
RATING_NEGATIVE_MAX=2
RATING_POSITIVE_MIN=4
RATING_MIN=1
RATING_MAX=5

# ---- Misc -------------------------------------------------------------------
SAVE_PREDICTIONS=true
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MODEL_DIR=models
# UPLOAD_DIR=../data/uploads
